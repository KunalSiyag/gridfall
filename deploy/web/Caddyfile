{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
	}
	handle /healthz {
		respond "ok" 200
	}
	# The loader page, the worker and the PWA manifest must revalidate; hashed payloads never change.
	@loader path / /index.html /index.service.worker.js /index.manifest.json
	header @loader Cache-Control "no-cache"
	@immutable path /releases/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	file_server {
		precompressed br gzip
	}
}
