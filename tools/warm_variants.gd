extends SceneTree
## Lists the shader variants (WarmSignature) the city holds in the street view and in the Planner
## view, and the ones only the Planner has. The Planner's materials are made when it first opens, so
## the shader warm-up cannot find them in the street scene; this tool finds them offline and, with
## --write, saves them as data/warm_orbit_variants.json (what ShaderWarmup rebuilds stand-ins from).
## Headless; boots the real Main on whatever city user:// holds (a saved city grows the list: seed
## one with XDG_DATA_HOME, as docs/runbooks/web-probe-kit.md describes), offline.
##
## usage: GRIDFALL_OFFLINE=1 XDG_DATA_HOME=<dir> godot --headless --path . -s tools/warm_variants.gd
## [-- --write]
## Prints WARMVARIANTS {json}: counts (street, planner, planner-only recipes) and the catalogue.

const OUT := "res://data/warm_orbit_variants.json"
const DOC := (
	"Generated by tools/warm_variants.gd: the shader variants only the Planner view holds (its "
	+ "materials are made when it first opens). ShaderWarmup rebuilds a stand-in for each with "
	+ "WarmSignature.build and draws it in the Planner's state."
)
const FRAMES := 12


func _init() -> void:
	await process_frame
	change_scene_to_packed(load("res://scenes/main.tscn") as PackedScene)
	for _k in FRAMES:
		await process_frame
	var main := current_scene
	if main == null or main.get("fp") == null:
		print("WARMVARIANTS no street view to read")
		quit(1)
		return
	var street := _variants(main)
	main.call("exit_fp")
	var view: Variant = main.get("view")
	if view != null and view.has_method("flush_rebuild_queue"):
		view.call("flush_rebuild_queue")
	for _k in FRAMES:
		await process_frame
	var planner := _variants(main)
	var only: Array = []
	for sig: String in planner:
		if not street.has(sig):
			only.append(planner[sig])
	only.sort_custom(
		func(a: Dictionary, b: Dictionary) -> bool: return str(a["sig"]) < str(b["sig"])
	)
	var catalogue: Array = []
	for e: Dictionary in only:
		if e["spec"] != null:
			(
				catalogue
				. append(
					{
						"sig": e["sig"],
						"spec": e["spec"],
						"multi": e["multi"],
						"colors": e["colors"],
						"custom": e["custom"],
						"shadow": e["shadow"],
						"n": e["n"],
					}
				)
			)
	var report := {
		"street_variants": street.size(),
		"planner_variants": planner.size(),
		"planner_only": only.size(),
		"catalogued": catalogue.size(),
		"instances_planner": _count(planner),
	}
	print("WARMVARIANTS ", JSON.stringify(report))
	for e: Dictionary in only:
		print(
			(
				"  only in the Planner: %s x%d (%s)"
				% [str(e["sig"]).left(110), int(e["n"]), "ok" if e["spec"] != null else "no spec"]
			)
		)
	if "--write" in OS.get_cmdline_user_args():
		var f := FileAccess.open(ProjectSettings.globalize_path(OUT), FileAccess.WRITE)
		f.store_string(JSON.stringify({"_doc": DOC, "variants": catalogue}, "\t"))
		f.close()
		print("wrote ", OUT)
	quit(0)


func _count(v: Dictionary) -> int:
	var n := 0
	for sig: String in v:
		n += int((v[sig] as Dictionary)["n"])
	return n


## signature + flags -> {"sig", "spec", "multi", "colors", "custom", "shadow", "n"} for the scene.
func _variants(main: Node) -> Dictionary:
	WarmCollector.by_variant = true
	var out := {}
	for rec: Dictionary in WarmCollector.collect(main, Vector3.ZERO, 100000):
		var mat := rec["override"] as Material
		var sig := str(rec["key"])
		out[sig] = {
			"sig": WarmSignature.of(mat),
			"spec": WarmSignature.describe(mat),
			"multi": rec["multi"],
			"colors": rec["colors"],
			"custom": rec["custom"],
			"shadow": rec["shadow"],
			"n": rec["n"],
		}
	return out
