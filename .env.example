# GridFall environment switches. Copy to .env and `set -a; . ./.env; set +a` before running godot.
# Never commit .env. Everything here is optional.

# GMI Cloud inference key (falls back to ~/.factory/settings.json, then replay cache + heuristics)
GMI_API_KEY=

# 1 = never call GMI (replay cache + heuristics). Tests always set this.
GRIDFALL_OFFLINE=0
# 1 = write live responses into data/gmi_replay_cache.json
GRIDFALL_RECORD=0

# Starting view: empty = first/third person, orbit = legacy orbit builder with the full HUD
GRIDFALL_VIEW=
# Starting game speed (1, 2, 4, 8)
GRIDFALL_SPEED=1
# 0 = no AI residents (formula behaviour, instant construction)
GRIDFALL_RESIDENTS=1
# Freeze the clock at an hour, e.g. 21.5 for night shots
GRIDFALL_HOUR=
# free = never capture the mouse in first person
GRIDFALL_MOUSE=
# 1 = start a new city instead of continuing the save
GRIDFALL_NEW_CITY=0

# Local, opt-in ops features (written under user://ops/, never uploaded)
GRIDFALL_ERROR_LOG=0
GRIDFALL_ANALYTICS=0
# Feature flag overrides, comma separated: flag=on,other_flag=off
GRIDFALL_FLAGS=

# Test and capture modes
GRIDFALL_SMOKE_TEST=0
GRIDFALL_FP_SMOKE=0
GRIDFALL_PHOTO_DIR=
GRIDFALL_PHOTO_DAYS=12
GRIDFALL_FP_PHOTO_DIR=
LIVE_RESIDENTS=30
