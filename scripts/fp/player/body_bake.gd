extends SceneTree
## Bakes the walking collision of every building and zone model into body_table.gd (slice A).
## body_shapes.gd costs 10-300 ms per model, so its results ship baked:
##   godot --headless --path . -s res://scripts/fp/player/body_bake.gd
## Re-run it after a building or zone GLB changes; CollisionWorld analyses a model whose bounds no
## longer match its entry at runtime (once per file, with a warning).
## With BODY_BAKE_REPORT=1 it prints every model's shapes instead of writing the table.

const BS := preload("res://scripts/fp/player/body_shapes.gd")
const AP := preload("res://scripts/fp/asset_paths.gd")
const OUT_PATH := "res://scripts/fp/player/body_table.gd"
const BAKE_DIRS := ["res://models/real/buildings/", "res://models/real/zones/", "res://models/buildings/", "res://models/zones/"]


func _init() -> void:
	var report := OS.get_environment("BODY_BAKE_REPORT") == "1"
	var only := OS.get_environment("BODY_BAKE_ONLY")
	var paths: Array[String] = []
	for d: String in BAKE_DIRS:
		_list(d, paths)
	paths.sort()
	var lines: PackedStringArray = []
	lines.append("extends RefCounted")
	lines.append("## Generated by body_bake.gd from %d models; do not edit by hand. Re-run the bake after a" % paths.size())
	lines.append("## building or zone GLB changes. path -> [bounds, bodies, walls, [x, z, r, top, ...]], all in")
	lines.append("## model space (see body_shapes.gd).")
	lines.append("")
	lines.append("const BODIES := {")
	var t0 := Time.get_ticks_msec()
	for p in paths:
		if not only.is_empty() and not p.contains(only):
			continue
		var ps := AP.load_scene(p)
		if ps == null:
			continue
		var n := ps.instantiate() as Node3D
		if n == null:
			continue
		var t1 := Time.get_ticks_usec()
		var r := BS.analyse(n)
		var us := Time.get_ticks_usec() - t1
		n.free()
		if report:
			_report(p, r, us)
			continue
		var bodies: PackedStringArray = []
		for b: AABB in r["bodies"]:
			bodies.append(_aabb(b))
		var walls: PackedStringArray = []
		for b: AABB in r["walls"]:
			walls.append(_aabb(b))
		var cyl: PackedStringArray = []
		for v: float in r["cyls"]:
			cyl.append(_f(v))
		lines.append("\t\"%s\": [%s, [%s], [%s], [%s]]," % [p, _aabb(r["bounds"]), ", ".join(bodies), ", ".join(walls), ", ".join(cyl)])
	lines.append("}")
	lines.append("")
	if not report:
		var f := FileAccess.open(OUT_PATH, FileAccess.WRITE)
		f.store_string("\n".join(lines))
		f.close()
	print("BODY_BAKE: %d models in %d ms%s" % [paths.size(), Time.get_ticks_msec() - t0, "" if report else " -> " + OUT_PATH])
	quit(0)


func _report(p: String, r: Dictionary, us: int) -> void:
	var b: AABB = r["bounds"]
	print("%s  %.0f ms  bounds x[%.3f,%.3f] z[%.3f,%.3f] top %.3f" % [p.get_file(), us / 1000.0, b.position.x, b.end.x, b.position.z, b.end.z, b.end.y])
	for x: AABB in r["bodies"]:
		print("   BODY x[%.3f,%.3f] z[%.3f,%.3f] y[%.3f,%.3f]" % [x.position.x, x.end.x, x.position.z, x.end.z, x.position.y, x.end.y])
	for x: AABB in r["walls"]:
		print("   WALL x[%.3f,%.3f] z[%.3f,%.3f] y[%.3f,%.3f]" % [x.position.x, x.end.x, x.position.z, x.end.z, x.position.y, x.end.y])
	var c: PackedFloat32Array = r["cyls"]
	for k in range(0, c.size(), 4):
		print("   CYL (%.3f, %.3f) r %.4f top %.3f" % [c[k], c[k + 1], c[k + 2], c[k + 3]])


static func _list(dir: String, out: Array[String]) -> void:
	var d := DirAccess.open(dir)
	if d == null:
		return
	for f: String in d.get_files():
		var nm := f.trim_suffix(".import").trim_suffix(".remap")
		if nm.ends_with(".glb") and not out.has(dir + nm):
			out.append(dir + nm)
	for sub: String in d.get_directories():
		_list(dir + sub + "/", out)


static func _aabb(b: AABB) -> String:
	return "AABB(Vector3(%s, %s, %s), Vector3(%s, %s, %s))" % [_f(b.position.x), _f(b.position.y), _f(b.position.z), _f(b.size.x), _f(b.size.y), _f(b.size.z)]


static func _f(v: float) -> String:
	return "%.5f" % v
